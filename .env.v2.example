# V2 line environment — copy to .env.v2
#
# The V2 production stack uses its own env file. Run it with:
#   docker compose --env-file .env.v2 -f docker-compose.v2.yml up -d
# (Docker Compose variable substitution reads --env-file, not .env.v2 by
# default; the file also feeds the containers via env_file / bind mounts.)
#
# The V2 line never shares mutable state with V1 (separate `-v2` volumes,
# DECISIONS D2). Do not point it at V1's `.env`.

# === OpenCode Settings ===
OPENCODE_SERVER_PASSWORD=devonly

# OpenCode plugins are empty on the V2 line (no OMO runtime, D1). The baked
# b1-routing / m3-enforcer plugins load from the image automatically.

# Custom OpenCode provider(s) to inject into opencode.json (JSON value of the
# "provider" key). Example:
# OPENCODE_PROVIDER={"ollama":{"npm":"@ai-sdk/openai-compatible","name":"Ollama","options":{"baseURL":"http://host:11434/v1"},"models":{"gemma4:12b":{"name":"gemma4:12b"}}}}

# === UI Settings ===
OPENCHAMBER_UI_PASSWORD=chamber
OPENCHAMBER_HOST=0.0.0.0

# === Ports (V2 prod; V1 prod 8000/8080, V1 dev 8001/8081, V2 dev 8003/8083) ===
CHAMBER_V2_PORT=8002
ADMIN_V2_PORT=8082

# === Admin Dashboard ===
ADMIN_PASSWORD=

# === Workspace (optional) ===
# Leave WORKSPACE_PATH unset to use the `workspace-v2` named volume (default).
# Set it to an absolute host path to bind-mount a host directory instead:
#   WORKSPACE_PATH=/home/user/projects
# Under Docker-out-of-Docker use an ABSOLUTE host path, never a relative one; a
# relative path resolves against the admin container's Compose directory and can
# bind the wrong host directory (see the README "DooD note").
# WORKSPACE_PATH=/home/user/projects

# === Version Pinning (optional) ===
# Pin the deployed V2 image tag. Leave unset to follow the V2 channel (`:v2`).
# AI_ENGKIT_VERSION=v2

# === Backup Settings ===
BACKUP_RETENTION=5

# === V2 Diagnostics Packages ===
# Extra runtime packages installed by entrypoint.d/01-install-packages.sh at
# container start. This is the dev default so a plain `cp .env.v2.example .env`
# stack can run test/test-v2.sh cell2/cell3 (CI uses the same file as its
# single source). Cost: these live in the container layer (~/.bun, linuxbrew),
# not in a named volume, so they reinstall on every container recreate and the
# first boot after a recreate is slower (go via brew dominates). Comment out
# if you never run the diagnostics cells.
BREW_PACKAGES="go"
# NOTE: @biomejs/cli-linux-x64 is explicit because `bun install -g` does not
# reliably pull @biomejs/biome's optional platform binary, leaving `biome`
# installed but unloadable (`Cannot find module '@biomejs/cli-linux-x64/biome'`
# breaks the v2 diagnostics catalog check). Container stack is linux-only.
BUN_PACKAGES="pyright @biomejs/biome @biomejs/cli-linux-x64 typescript@5.8.3"

# === Agent Connection (optional) ===
# CENTER_URL=wss://center.example.com/agent?token=YOUR_TOKEN&ca=<base64url-PEM>
# CENTER_TOKEN=
