# V2 line environment — copy to .env.v2
#
# The V2 production stack uses its own env file. Run it with:
#   docker compose --env-file .env.v2 -f docker-compose.v2.yml up -d
# (Docker Compose variable substitution reads --env-file, not .env.v2 by
# default; the file also feeds the containers via env_file / bind mounts.)
#
# The V2 line never shares mutable state with V1 (separate `-v2` volumes,
# DECISIONS D2). Do not point it at V1's `.env`.

# === OpenCode Settings ===
OPENCODE_SERVER_PASSWORD=devonly

# OpenCode plugins are empty on the V2 line (no OMO runtime, D1). The baked
# b1-routing / m3-enforcer plugins load from the image automatically.

# Custom OpenCode provider(s) to inject into opencode.json (JSON value of the
# "provider" key). Example:
# OPENCODE_PROVIDER={"ollama":{"npm":"@ai-sdk/openai-compatible","name":"Ollama","options":{"baseURL":"http://host:11434/v1"},"models":{"gemma4:12b":{"name":"gemma4:12b"}}}}

# === UI Settings ===
OPENCHAMBER_UI_PASSWORD=chamber
OPENCHAMBER_HOST=0.0.0.0

# === Ports (V2 prod; V1 prod 8000/8080, V1 dev 8001/8081, V2 dev 8003/8083) ===
CHAMBER_V2_PORT=8002
ADMIN_V2_PORT=8082

# === Admin Dashboard ===
ADMIN_PASSWORD=

# === Version Pinning (optional) ===
# Pin the deployed V2 image tag. Leave unset to follow the V2 channel (`:v2`).
# AI_ENGKIT_VERSION=v2

# === Backup Settings ===
BACKUP_RETENTION=5

# === Agent Connection (optional) ===
# CENTER_URL=wss://center.example.com/agent?token=YOUR_TOKEN&ca=<base64url-PEM>
# CENTER_TOKEN=
