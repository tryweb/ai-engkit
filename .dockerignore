# Git
.git/
.gitattributes
.gitignore

# CI / GitHub
.github/

# Tests
test/*
!test/fixtures/
test/fixtures/*
!test/fixtures/compose-overlay/
entrypoint.d/*.test.sh
test-output.txt

# Documentation (not needed in runtime image)
docs/
*.md
*.mdx
# Exception: the image bundles MIT-licensed third-party components, so the
# applicable third-party license terms must travel with it.
!THIRD-PARTY-NOTICES.md

# Environment & config
.env
.env.*
docker-compose*.yml
docker-compose*.yaml
!docker-compose.v2.yml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Local tooling / indexes (never needed in the image; .codegraph also carries
# a unix socket that legacy build context tar cannot archive)
.codegraph/
.sisyphus/
