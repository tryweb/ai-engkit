# Git
.git/
.gitattributes
.gitignore

# CI / GitHub
.github/

# Tests
test/*
!test/fixtures/
test/fixtures/*
!test/fixtures/compose-overlay/
entrypoint.d/*.test.sh
test-output.txt

# Documentation (not needed in runtime image)
docs/
*.md
*.mdx
# Exception: the image ships a modified copy of oh-my-openagent's default config
# (.opencode/omo.jsonc.default), so the applicable third-party license terms
# must travel with it (SUL-1.0 "Notices").
!THIRD-PARTY-NOTICES.md

# Environment & config
.env
.env.*
docker-compose*.yml
docker-compose*.yaml
!docker-compose.yml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Local tooling / indexes (never needed in the image; .codegraph also carries
# a unix socket that legacy build context tar cannot archive)
.codegraph/
.sisyphus/
