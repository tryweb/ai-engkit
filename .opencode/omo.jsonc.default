{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v5.1.30/assets/omo.schema.json",
  "agents": {
    "plan": {
      "models": [
        {
          "model": "opencode-go/kimi-k3",
          "variant": "max"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "high"
        },
        {
          "model": "openai/gpt-5.6-luna"
        }
      ]
    },
    "prometheus": {
      "models": [
        {
          "model": "opencode-go/kimi-k3",
          "variant": "max"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "high"
        },
        {
          "model": "openai/gpt-5.6-luna"
        }
      ],
      "tools": {
        "read": true,
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "explore": {
      "tools": {
        "read": true,
        "bash": true,
        "edit": false,
        "write": false
      }
    },
    "oracle": {
      "tools": {
        "read": true,
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "librarian": {
      "tools": {
        "read": true,
        "bash": false,
        "edit": false,
        "write": false,
        "webfetch": true
      }
    },
    "multimodal-looker": {
      "tools": {
        "read": true,
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "metis": {
      "tools": {
        "read": true,
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "momus": {
      "tools": {
        "read": true,
        "bash": false,
        "edit": false,
        "write": false
      }
    },
    "sisyphus": {},
    "hephaestus": {},
    "atlas": {},
    "sisyphus-junior": {}
  }
}
